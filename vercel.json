{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "sh scripts/vercel_build.sh",
  "outputDirectory": "public",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/app/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/app/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*/",
      "destination": "https://cafetal-hub-demo.onrender.com/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://cafetal-hub-demo.onrender.com/api/:path*"
    }
  ]
}
